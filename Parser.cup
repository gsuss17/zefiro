import java_cup.runtime.*;

parser code {:
    public int erroresSintacticos = 0;
    public Nodo raizAST = null;

    @Override
    public void syntax_error(Symbol s) {
        erroresSintacticos++;
        String nombreToken = (s.sym >= 0 && s.sym < sym.terminalNames.length)
                             ? sym.terminalNames[s.sym]
                             : ("TOKEN_" + s.sym);
        String lexema = (s.value != null) ? s.value.toString() : nombreToken;

        java.util.List<Integer> idsEsperados = expected_token_ids();
        java.util.List<String> nombresEsperados = new java.util.ArrayList<>();

        for (int id : idsEsperados) {
            if (id != sym.error && id >= 0 && id < sym.terminalNames.length) {
                nombresEsperados.add(describirToken(id, sym.terminalNames[id]));
            }
        }

        String listaEsperados = nombresEsperados.isEmpty()
                                ? "Ninguno"
                                : String.join(", ", nombresEsperados);

        System.out.println(" -> Error sintáctico en Línea " + s.left + ", Columna " + s.right +
                           ". No se esperaba: '" + lexema + "' (" + nombreToken + ")");
        System.out.println("    Tokens válidos esperados en esta posición: [ " + listaEsperados + " ]");
    }

    @Override
    public void unrecovered_syntax_error(Symbol s) throws java.lang.Exception {
        System.out.println(" -> Error sintáctico fatal en Línea " + s.left + ", Columna " + s.right +
                           ". No se pudo recuperar el análisis.");
    }

    private String describirToken(int id, String nombre) {
        switch (nombre) {
            case "PR_INICIO": return "'INICIO'";
            case "PR_FIN": return "'FIN'";
            case "PR_TIPO_ENT": return "'ENTERO'";
            case "PR_TIPO_DEC": return "'DECIMAL'";
            case "PR_TIPO_CAD": return "'CADENA'";
            case "PR_TIPO_BOOL": return "'BOOLEANO'";
            case "PR_VACIO": return "'VACIO'";
            case "PR_SI": return "'SI'";
            case "PR_SINO": return "'SINO'";
            case "PR_FINSI": return "'FINSI'";
            case "PR_MIENTRAS": return "'MIENTRAS'";
            case "PR_FIN_MIE": return "'FINMIENTRAS'";
            case "PR_PARA": return "'PARA'";
            case "PR_FIN_PARA": return "'FINPARA'";
            case "PR_ROMPER": return "'ROMPER'";
            case "PR_CONTINUAR": return "'CONTINUAR'";
            case "PR_FUNCION": return "'FUNCION'";
            case "PR_FIN_FUNCION": return "'FINFUNCION'";
            case "PR_RETORNAR": return "'RETORNAR'";
            case "PR_LEER": return "'LEER'";
            case "PR_IMPRIMIR": return "'IMPRIMIR'";
            case "DEL_P_COMA": return "';'";
            case "DEL_COMA": return "','";
            case "DEL_PAR_IZQ": return "'('";
            case "DEL_PAR_DER": return "')'";
            case "OP_ASIGNA": return "'='";
            case "OP_SUMA": return "'+'";
            case "OP_RESTA": return "'-'";
            case "OP_MULT": return "'*'";
            case "OP_DIV": return "'/'";
            case "OP_MOD": return "'%'";
            case "OP_IGUAL": return "'=='";
            case "OP_DIFERENTE": return "'!='";
            case "OP_MENOR": return "'<'";
            case "OP_MENOR_IGUAL": return "'<='";
            case "OP_MAYOR": return "'>'";
            case "OP_MAYOR_IGUAL": return "'>='";
            case "OP_Y": return "'Y'";
            case "OP_O": return "'O'";
            case "OP_NO": return "'NO'";
            case "ID": return "Identificador";
            case "LIT_ENTERO": return "Número Entero";
            case "LIT_DECIMAL": return "Número Decimal";
            case "LIT_CADENA": return "Texto";
            case "LIT_VERDADERO": return "'VERDADERO'";
            case "LIT_FALSO": return "'FALSO'";
            default: return nombre;
        }
    }
:};

/* Terminales */
terminal PR_INICIO, PR_FIN;
terminal PR_TIPO_ENT, PR_TIPO_DEC, PR_TIPO_CAD, PR_TIPO_BOOL, PR_VACIO;
terminal LIT_VERDADERO, LIT_FALSO;
terminal PR_SI, PR_SINO, PR_FINSI;
terminal PR_MIENTRAS, PR_FIN_MIE;
terminal PR_PARA, PR_FIN_PARA;
terminal PR_ROMPER, PR_CONTINUAR;
terminal PR_FUNCION, PR_FIN_FUNCION, PR_RETORNAR;
terminal PR_LEER, PR_IMPRIMIR;

terminal OP_SUMA, OP_RESTA, OP_MULT, OP_DIV, OP_MOD;
terminal OP_ASIGNA;
terminal OP_IGUAL, OP_DIFERENTE, OP_MENOR, OP_MENOR_IGUAL, OP_MAYOR, OP_MAYOR_IGUAL;
terminal OP_Y, OP_O, OP_NO;

terminal DEL_P_COMA, DEL_COMA, DEL_PAR_IZQ, DEL_PAR_DER;

terminal String ID;
terminal String LIT_ENTERO;
terminal String LIT_DECIMAL;
terminal String LIT_CADENA;

terminal MENOS_UNARIO;

/* No Terminales tipados con Nodo */
non terminal Nodo programa;
non terminal Nodo lista_funciones_opt, lista_funciones, funcion, tipo_retorno;
non terminal Nodo parametros_opt, lista_parametros, parametro;
non terminal Nodo lista_sentencias_opt, lista_sentencias, sentencia;
non terminal Nodo tipo, declaracion, lista_vars, var_item;
non terminal Nodo asignacion, condicional, ciclo, ciclo_para, para_init;
non terminal Nodo lectura, escritura, retorno, llamada_funcion;
non terminal Nodo argumentos_opt, lista_argumentos;
non terminal Nodo expresion;

/* Precedencia y Asociatividad */
precedence left OP_O;
precedence left OP_Y;
precedence right OP_NO;
precedence left OP_IGUAL, OP_DIFERENTE;
precedence left OP_MENOR, OP_MENOR_IGUAL, OP_MAYOR, OP_MAYOR_IGUAL;
precedence left OP_SUMA, OP_RESTA;
precedence left OP_MULT, OP_DIV, OP_MOD;
precedence right MENOS_UNARIO;

/* Símbolo Inicial */
start with programa;

/* Reglas Gramaticales */
programa ::=
    PR_INICIO:ini ID:id DEL_P_COMA lista_funciones_opt:lf lista_sentencias_opt:ls PR_FIN DEL_P_COMA
    {:
        Nodo n = new Nodo("PROGRAMA", inileft, iniright);
        n.agregarHijo(new Nodo("PR_INICIO", "INICIO", inileft, iniright));
        n.agregarHijo(new Nodo("ID", id, idleft, idright));
        n.agregarHijo(new Nodo("DEL_P_COMA", ";"));
        if (lf != null) n.agregarHijo(lf);
        n.agregarHijo(ls);
        n.agregarHijo(new Nodo("PR_FIN", "FIN"));
        n.agregarHijo(new Nodo("DEL_P_COMA", ";"));
        parser.raizAST = n;
        RESULT = n;
    :}
;

lista_funciones_opt ::=
    lista_funciones:lf
    {:
        RESULT = lf;
    :}
    | /* vacío */
    {:
        RESULT = null;
    :}
;

lista_funciones ::=
    lista_funciones:lf funcion:f
    {:
        lf.agregarHijo(f);
        RESULT = lf;
    :}
    | funcion:f
    {:
        Nodo n = new Nodo("LISTA_FUNCIONES");
        n.agregarHijo(f);
        RESULT = n;
    :}
;

funcion ::=
    PR_FUNCION:fn tipo_retorno:tr ID:id DEL_PAR_IZQ parametros_opt:po DEL_PAR_DER lista_sentencias_opt:ls PR_FIN_FUNCION DEL_P_COMA
    {:
        Nodo n = new Nodo("FUNCION", fnleft, fnright);
        n.agregarHijo(new Nodo("PR_FUNCION", "FUNCION", fnleft, fnright));
        n.agregarHijo(tr);
        n.agregarHijo(new Nodo("ID", id, idleft, idright));
        n.agregarHijo(new Nodo("DEL_PAR_IZQ", "("));
        if (po != null) n.agregarHijo(po);
        n.agregarHijo(new Nodo("DEL_PAR_DER", ")"));
        n.agregarHijo(ls);
        n.agregarHijo(new Nodo("PR_FIN_FUNCION", "FINFUNCION"));
        n.agregarHijo(new Nodo("DEL_P_COMA", ";"));
        RESULT = n;
    :}
    | PR_FUNCION:fn error PR_FIN_FUNCION DEL_P_COMA
    {:
        Nodo n = new Nodo("FUNCION", fnleft, fnright);
        n.agregarHijo(new Nodo("PR_FUNCION", "FUNCION", fnleft, fnright));
        n.agregarHijo(new Nodo("ERROR_FUNCION"));
        n.agregarHijo(new Nodo("PR_FIN_FUNCION", "FINFUNCION"));
        n.agregarHijo(new Nodo("DEL_P_COMA", ";"));
        RESULT = n;
    :}
;

tipo_retorno ::=
    tipo:t
    {:
        RESULT = t;
    :}
    | PR_VACIO:v
    {:
        Nodo n = new Nodo("TIPO", vleft, vright);
        n.agregarHijo(new Nodo("PR_VACIO", "VACIO", vleft, vright));
        RESULT = n;
    :}
;

parametros_opt ::=
    lista_parametros:lp
    {:
        RESULT = lp;
    :}
    | /* vacío */
    {:
        RESULT = null;
    :}
;

lista_parametros ::=
    lista_parametros:lp DEL_COMA parametro:p
    {:
        lp.agregarHijo(new Nodo("DEL_COMA", ","));
        lp.agregarHijo(p);
        RESULT = lp;
    :}
    | parametro:p
    {:
        Nodo n = new Nodo("LISTA_PARAMETROS");
        n.agregarHijo(p);
        RESULT = n;
    :}
;

parametro ::=
    tipo:t ID:id
    {:
        Nodo n = new Nodo("PARAMETRO", idleft, idright);
        n.agregarHijo(t);
        n.agregarHijo(new Nodo("ID", id, idleft, idright));
        RESULT = n;
    :}
;

lista_sentencias_opt ::=
    lista_sentencias:ls
    {:
        RESULT = ls;
    :}
    | /* vacío */
    {:
        RESULT = new Nodo("LISTA_SENTENCIAS");
    :}
;

lista_sentencias ::=
    lista_sentencias:ls sentencia:s
    {:
        ls.agregarHijo(s);
        RESULT = ls;
    :}
    | sentencia:s
    {:
        Nodo n = new Nodo("LISTA_SENTENCIAS");
        n.agregarHijo(s);
        RESULT = n;
    :}
;

sentencia ::=
    declaracion:d DEL_P_COMA
    {:
        Nodo n = new Nodo("SENTENCIA", dleft, dright);
        n.agregarHijo(d);
        n.agregarHijo(new Nodo("DEL_P_COMA", ";"));
        RESULT = n;
    :}
    | asignacion:a DEL_P_COMA
    {:
        Nodo n = new Nodo("SENTENCIA", aleft, aright);
        n.agregarHijo(a);
        n.agregarHijo(new Nodo("DEL_P_COMA", ";"));
        RESULT = n;
    :}
    | condicional:c
    {:
        Nodo n = new Nodo("SENTENCIA", cleft, cright);
        n.agregarHijo(c);
        RESULT = n;
    :}
    | ciclo:m
    {:
        Nodo n = new Nodo("SENTENCIA", mleft, mright);
        n.agregarHijo(m);
        RESULT = n;
    :}
    | ciclo_para:p
    {:
        Nodo n = new Nodo("SENTENCIA", pleft, pright);
        n.agregarHijo(p);
        RESULT = n;
    :}
    | lectura:l DEL_P_COMA
    {:
        Nodo n = new Nodo("SENTENCIA", lleft, lright);
        n.agregarHijo(l);
        n.agregarHijo(new Nodo("DEL_P_COMA", ";"));
        RESULT = n;
    :}
    | escritura:e DEL_P_COMA
    {:
        Nodo n = new Nodo("SENTENCIA", eleft, eright);
        n.agregarHijo(e);
        n.agregarHijo(new Nodo("DEL_P_COMA", ";"));
        RESULT = n;
    :}
    | llamada_funcion:lf DEL_P_COMA
    {:
        Nodo n = new Nodo("SENTENCIA", lfleft, lfright);
        n.agregarHijo(lf);
        n.agregarHijo(new Nodo("DEL_P_COMA", ";"));
        RESULT = n;
    :}
    | retorno:r DEL_P_COMA
    {:
        Nodo n = new Nodo("SENTENCIA", rleft, rright);
        n.agregarHijo(r);
        n.agregarHijo(new Nodo("DEL_P_COMA", ";"));
        RESULT = n;
    :}
    | PR_ROMPER:rm DEL_P_COMA
    {:
        Nodo n = new Nodo("SENTENCIA", rmleft, rmright);
        n.agregarHijo(new Nodo("ROMPER", "ROMPER", rmleft, rmright));
        n.agregarHijo(new Nodo("DEL_P_COMA", ";"));
        RESULT = n;
    :}
    | PR_CONTINUAR:ct DEL_P_COMA
    {:
        Nodo n = new Nodo("SENTENCIA", ctleft, ctright);
        n.agregarHijo(new Nodo("CONTINUAR", "CONTINUAR", ctleft, ctright));
        n.agregarHijo(new Nodo("DEL_P_COMA", ";"));
        RESULT = n;
    :}
    | error DEL_P_COMA
    {:
        Nodo n = new Nodo("SENTENCIA");
        n.agregarHijo(new Nodo("ERROR_SINTACTICO"));
        n.agregarHijo(new Nodo("DEL_P_COMA", ";"));
        RESULT = n;
    :}
;

tipo ::=
    PR_TIPO_ENT:t
    {:
        Nodo n = new Nodo("TIPO", tleft, tright);
        n.agregarHijo(new Nodo("PR_TIPO_ENT", "ENTERO", tleft, tright));
        RESULT = n;
    :}
    | PR_TIPO_DEC:t
    {:
        Nodo n = new Nodo("TIPO", tleft, tright);
        n.agregarHijo(new Nodo("PR_TIPO_DEC", "DECIMAL", tleft, tright));
        RESULT = n;
    :}
    | PR_TIPO_CAD:t
    {:
        Nodo n = new Nodo("TIPO", tleft, tright);
        n.agregarHijo(new Nodo("PR_TIPO_CAD", "CADENA", tleft, tright));
        RESULT = n;
    :}
    | PR_TIPO_BOOL:t
    {:
        Nodo n = new Nodo("TIPO", tleft, tright);
        n.agregarHijo(new Nodo("PR_TIPO_BOOL", "BOOLEANO", tleft, tright));
        RESULT = n;
    :}
;

declaracion ::=
    tipo:t lista_vars:lv
    {:
        Nodo n = new Nodo("DECLARACION", tleft, tright);
        n.agregarHijo(t);
        n.agregarHijo(lv);
        RESULT = n;
    :}
    | tipo:t error
    {:
        Nodo n = new Nodo("DECLARACION", tleft, tright);
        n.agregarHijo(t);
        n.agregarHijo(new Nodo("ERROR_DECLARACION"));
        RESULT = n;
    :}
;

lista_vars ::=
    lista_vars:lv DEL_COMA var_item:vi
    {:
        lv.agregarHijo(new Nodo("DEL_COMA", ","));
        lv.agregarHijo(vi);
        RESULT = lv;
    :}
    | var_item:vi
    {:
        Nodo n = new Nodo("LISTA_VARS");
        n.agregarHijo(vi);
        RESULT = n;
    :}
;

var_item ::=
    ID:id
    {:
        Nodo n = new Nodo("VAR_ITEM", idleft, idright);
        n.agregarHijo(new Nodo("ID", id, idleft, idright));
        RESULT = n;
    :}
    | ID:id OP_ASIGNA expresion:e
    {:
        Nodo n = new Nodo("VAR_ITEM", idleft, idright);
        n.agregarHijo(new Nodo("ID", id, idleft, idright));
        n.agregarHijo(new Nodo("OP_ASIGNA", "="));
        n.agregarHijo(e);
        RESULT = n;
    :}
;

asignacion ::=
    ID:id OP_ASIGNA expresion:e
    {:
        Nodo n = new Nodo("ASIGNACION", idleft, idright);
        n.agregarHijo(new Nodo("ID", id, idleft, idright));
        n.agregarHijo(new Nodo("OP_ASIGNA", "="));
        n.agregarHijo(e);
        RESULT = n;
    :}
    | ID:id error
    {:
        Nodo n = new Nodo("ASIGNACION", idleft, idright);
        n.agregarHijo(new Nodo("ID", id, idleft, idright));
        n.agregarHijo(new Nodo("ERROR_ASIGNACION"));
        RESULT = n;
    :}
;

condicional ::=
    PR_SI:si DEL_PAR_IZQ expresion:cond DEL_PAR_DER lista_sentencias_opt:ls PR_FINSI DEL_P_COMA
    {:
        Nodo n = new Nodo("CONDICIONAL", sileft, siright);
        n.agregarHijo(new Nodo("PR_SI", "SI", sileft, siright));
        n.agregarHijo(new Nodo("DEL_PAR_IZQ", "("));
        n.agregarHijo(cond);
        n.agregarHijo(new Nodo("DEL_PAR_DER", ")"));
        n.agregarHijo(ls);
        n.agregarHijo(new Nodo("PR_FINSI", "FINSI"));
        n.agregarHijo(new Nodo("DEL_P_COMA", ";"));
        RESULT = n;
    :}
    | PR_SI:si DEL_PAR_IZQ expresion:cond DEL_PAR_DER lista_sentencias_opt:ls1 PR_SINO lista_sentencias_opt:ls2 PR_FINSI DEL_P_COMA
    {:
        Nodo n = new Nodo("CONDICIONAL", sileft, siright);
        n.agregarHijo(new Nodo("PR_SI", "SI", sileft, siright));
        n.agregarHijo(new Nodo("DEL_PAR_IZQ", "("));
        n.agregarHijo(cond);
        n.agregarHijo(new Nodo("DEL_PAR_DER", ")"));
        n.agregarHijo(ls1);
        n.agregarHijo(new Nodo("PR_SINO", "SINO"));
        n.agregarHijo(ls2);
        n.agregarHijo(new Nodo("PR_FINSI", "FINSI"));
        n.agregarHijo(new Nodo("DEL_P_COMA", ";"));
        RESULT = n;
    :}
    | PR_SI:si error PR_FINSI DEL_P_COMA
    {:
        Nodo n = new Nodo("CONDICIONAL", sileft, siright);
        n.agregarHijo(new Nodo("PR_SI", "SI", sileft, siright));
        n.agregarHijo(new Nodo("ERROR_CONDICIONAL"));
        n.agregarHijo(new Nodo("PR_FINSI", "FINSI"));
        n.agregarHijo(new Nodo("DEL_P_COMA", ";"));
        RESULT = n;
    :}
;

ciclo ::=
    PR_MIENTRAS:m DEL_PAR_IZQ expresion:cond DEL_PAR_DER lista_sentencias_opt:ls PR_FIN_MIE DEL_P_COMA
    {:
        Nodo n = new Nodo("CICLO", mleft, mright);
        n.agregarHijo(new Nodo("PR_MIENTRAS", "MIENTRAS", mleft, mright));
        n.agregarHijo(new Nodo("DEL_PAR_IZQ", "("));
        n.agregarHijo(cond);
        n.agregarHijo(new Nodo("DEL_PAR_DER", ")"));
        n.agregarHijo(ls);
        n.agregarHijo(new Nodo("PR_FIN_MIE", "FINMIENTRAS"));
        n.agregarHijo(new Nodo("DEL_P_COMA", ";"));
        RESULT = n;
    :}
    | PR_MIENTRAS:m error PR_FIN_MIE DEL_P_COMA
    {:
        Nodo n = new Nodo("CICLO", mleft, mright);
        n.agregarHijo(new Nodo("PR_MIENTRAS", "MIENTRAS", mleft, mright));
        n.agregarHijo(new Nodo("ERROR_CICLO"));
        n.agregarHijo(new Nodo("PR_FIN_MIE", "FINMIENTRAS"));
        n.agregarHijo(new Nodo("DEL_P_COMA", ";"));
        RESULT = n;
    :}
;

ciclo_para ::=
    PR_PARA:p DEL_PAR_IZQ para_init:ini DEL_P_COMA expresion:cond DEL_P_COMA asignacion:paso DEL_PAR_DER lista_sentencias_opt:ls PR_FIN_PARA DEL_P_COMA
    {:
        Nodo n = new Nodo("CICLO_PARA", pleft, pright);
        n.agregarHijo(new Nodo("PR_PARA", "PARA", pleft, pright));
        n.agregarHijo(new Nodo("DEL_PAR_IZQ", "("));
        n.agregarHijo(ini);
        n.agregarHijo(new Nodo("DEL_P_COMA", ";"));
        n.agregarHijo(cond);
        n.agregarHijo(new Nodo("DEL_P_COMA", ";"));
        n.agregarHijo(paso);
        n.agregarHijo(new Nodo("DEL_PAR_DER", ")"));
        n.agregarHijo(ls);
        n.agregarHijo(new Nodo("PR_FIN_PARA", "FINPARA"));
        n.agregarHijo(new Nodo("DEL_P_COMA", ";"));
        RESULT = n;
    :}
    | PR_PARA:p error PR_FIN_PARA DEL_P_COMA
    {:
        Nodo n = new Nodo("CICLO_PARA", pleft, pright);
        n.agregarHijo(new Nodo("PR_PARA", "PARA", pleft, pright));
        n.agregarHijo(new Nodo("ERROR_CICLO_PARA"));
        n.agregarHijo(new Nodo("PR_FIN_PARA", "FINPARA"));
        n.agregarHijo(new Nodo("DEL_P_COMA", ";"));
        RESULT = n;
    :}
;

para_init ::=
    declaracion:d
    {:
        RESULT = d;
    :}
    | asignacion:a
    {:
        RESULT = a;
    :}
;

lectura ::=
    PR_LEER:l DEL_PAR_IZQ ID:id DEL_PAR_DER
    {:
        Nodo n = new Nodo("LECTURA", lleft, lright);
        n.agregarHijo(new Nodo("PR_LEER", "LEER", lleft, lright));
        n.agregarHijo(new Nodo("DEL_PAR_IZQ", "("));
        n.agregarHijo(new Nodo("ID", id, idleft, idright));
        n.agregarHijo(new Nodo("DEL_PAR_DER", ")"));
        RESULT = n;
    :}
    | PR_LEER:l error
    {:
        Nodo n = new Nodo("LECTURA", lleft, lright);
        n.agregarHijo(new Nodo("PR_LEER", "LEER", lleft, lright));
        n.agregarHijo(new Nodo("ERROR_LECTURA"));
        RESULT = n;
    :}
;

escritura ::=
    PR_IMPRIMIR:imp DEL_PAR_IZQ expresion:e DEL_PAR_DER
    {:
        Nodo n = new Nodo("ESCRITURA", impleft, impright);
        n.agregarHijo(new Nodo("PR_IMPRIMIR", "IMPRIMIR", impleft, impright));
        n.agregarHijo(new Nodo("DEL_PAR_IZQ", "("));
        n.agregarHijo(e);
        n.agregarHijo(new Nodo("DEL_PAR_DER", ")"));
        RESULT = n;
    :}
    | PR_IMPRIMIR:imp error
    {:
        Nodo n = new Nodo("ESCRITURA", impleft, impright);
        n.agregarHijo(new Nodo("PR_IMPRIMIR", "IMPRIMIR", impleft, impright));
        n.agregarHijo(new Nodo("ERROR_ESCRITURA"));
        RESULT = n;
    :}
;

retorno ::=
    PR_RETORNAR:r expresion:e
    {:
        Nodo n = new Nodo("RETORNAR", rleft, rright);
        n.agregarHijo(new Nodo("PR_RETORNAR", "RETORNAR", rleft, rright));
        n.agregarHijo(e);
        RESULT = n;
    :}
    | PR_RETORNAR:r
    {:
        Nodo n = new Nodo("RETORNAR", rleft, rright);
        n.agregarHijo(new Nodo("PR_RETORNAR", "RETORNAR", rleft, rright));
        RESULT = n;
    :}
;

llamada_funcion ::=
    ID:id DEL_PAR_IZQ argumentos_opt:ao DEL_PAR_DER
    {:
        Nodo n = new Nodo("LLAMADA_FUNCION", idleft, idright);
        n.agregarHijo(new Nodo("ID", id, idleft, idright));
        n.agregarHijo(new Nodo("DEL_PAR_IZQ", "("));
        if (ao != null) n.agregarHijo(ao);
        n.agregarHijo(new Nodo("DEL_PAR_DER", ")"));
        RESULT = n;
    :}
;

argumentos_opt ::=
    lista_argumentos:la
    {:
        RESULT = la;
    :}
    | /* vacío */
    {:
        RESULT = null;
    :}
;

lista_argumentos ::=
    lista_argumentos:la DEL_COMA expresion:e
    {:
        la.agregarHijo(new Nodo("DEL_COMA", ","));
        la.agregarHijo(e);
        RESULT = la;
    :}
    | expresion:e
    {:
        Nodo n = new Nodo("LISTA_ARGUMENTOS");
        n.agregarHijo(e);
        RESULT = n;
    :}
;

expresion ::=
    expresion:e1 OP_SUMA expresion:e2
    {:
        Nodo n = new Nodo("EXPRESION", e1left, e1right);
        n.agregarHijo(e1);
        n.agregarHijo(new Nodo("OP_SUMA", "+"));
        n.agregarHijo(e2);
        RESULT = n;
    :}
    | expresion:e1 OP_RESTA expresion:e2
    {:
        Nodo n = new Nodo("EXPRESION", e1left, e1right);
        n.agregarHijo(e1);
        n.agregarHijo(new Nodo("OP_RESTA", "-"));
        n.agregarHijo(e2);
        RESULT = n;
    :}
    | expresion:e1 OP_MULT expresion:e2
    {:
        Nodo n = new Nodo("EXPRESION", e1left, e1right);
        n.agregarHijo(e1);
        n.agregarHijo(new Nodo("OP_MULT", "*"));
        n.agregarHijo(e2);
        RESULT = n;
    :}
    | expresion:e1 OP_DIV expresion:e2
    {:
        Nodo n = new Nodo("EXPRESION", e1left, e1right);
        n.agregarHijo(e1);
        n.agregarHijo(new Nodo("OP_DIV", "/"));
        n.agregarHijo(e2);
        RESULT = n;
    :}
    | expresion:e1 OP_MOD expresion:e2
    {:
        Nodo n = new Nodo("EXPRESION", e1left, e1right);
        n.agregarHijo(e1);
        n.agregarHijo(new Nodo("OP_MOD", "%"));
        n.agregarHijo(e2);
        RESULT = n;
    :}
    | expresion:e1 OP_IGUAL expresion:e2
    {:
        Nodo n = new Nodo("EXPRESION", e1left, e1right);
        n.agregarHijo(e1);
        n.agregarHijo(new Nodo("OP_IGUAL", "=="));
        n.agregarHijo(e2);
        RESULT = n;
    :}
    | expresion:e1 OP_DIFERENTE expresion:e2
    {:
        Nodo n = new Nodo("EXPRESION", e1left, e1right);
        n.agregarHijo(e1);
        n.agregarHijo(new Nodo("OP_DIFERENTE", "!="));
        n.agregarHijo(e2);
        RESULT = n;
    :}
    | expresion:e1 OP_MENOR expresion:e2
    {:
        Nodo n = new Nodo("EXPRESION", e1left, e1right);
        n.agregarHijo(e1);
        n.agregarHijo(new Nodo("OP_MENOR", "<"));
        n.agregarHijo(e2);
        RESULT = n;
    :}
    | expresion:e1 OP_MENOR_IGUAL expresion:e2
    {:
        Nodo n = new Nodo("EXPRESION", e1left, e1right);
        n.agregarHijo(e1);
        n.agregarHijo(new Nodo("OP_MENOR_IGUAL", "<="));
        n.agregarHijo(e2);
        RESULT = n;
    :}
    | expresion:e1 OP_MAYOR expresion:e2
    {:
        Nodo n = new Nodo("EXPRESION", e1left, e1right);
        n.agregarHijo(e1);
        n.agregarHijo(new Nodo("OP_MAYOR", ">"));
        n.agregarHijo(e2);
        RESULT = n;
    :}
    | expresion:e1 OP_MAYOR_IGUAL expresion:e2
    {:
        Nodo n = new Nodo("EXPRESION", e1left, e1right);
        n.agregarHijo(e1);
        n.agregarHijo(new Nodo("OP_MAYOR_IGUAL", ">="));
        n.agregarHijo(e2);
        RESULT = n;
    :}
    | expresion:e1 OP_Y expresion:e2
    {:
        Nodo n = new Nodo("EXPRESION", e1left, e1right);
        n.agregarHijo(e1);
        n.agregarHijo(new Nodo("OP_Y", "Y"));
        n.agregarHijo(e2);
        RESULT = n;
    :}
    | expresion:e1 OP_O expresion:e2
    {:
        Nodo n = new Nodo("EXPRESION", e1left, e1right);
        n.agregarHijo(e1);
        n.agregarHijo(new Nodo("OP_O", "O"));
        n.agregarHijo(e2);
        RESULT = n;
    :}
    | OP_NO:op expresion:e
    {:
        Nodo n = new Nodo("EXPRESION", opleft, opright);
        n.agregarHijo(new Nodo("OP_NO", "NO", opleft, opright));
        n.agregarHijo(e);
        RESULT = n;
    :}
    | OP_RESTA:op expresion:e
    {:
        Nodo n = new Nodo("EXPRESION", opleft, opright);
        n.agregarHijo(new Nodo("OP_RESTA", "-", opleft, opright));
        n.agregarHijo(e);
        RESULT = n;
    :}
    %prec MENOS_UNARIO
    | DEL_PAR_IZQ:pi expresion:e DEL_PAR_DER
    {:
        Nodo n = new Nodo("EXPRESION", pileft, piright);
        n.agregarHijo(new Nodo("DEL_PAR_IZQ", "(", pileft, piright));
        n.agregarHijo(e);
        n.agregarHijo(new Nodo("DEL_PAR_DER", ")"));
        RESULT = n;
    :}
    | llamada_funcion:lf
    {:
        RESULT = lf;
    :}
    | ID:id
    {:
        RESULT = new Nodo("ID", id, idleft, idright);
    :}
    | LIT_ENTERO:val
    {:
        RESULT = new Nodo("LIT_ENTERO", val, valleft, valright);
    :}
    | LIT_DECIMAL:val
    {:
        RESULT = new Nodo("LIT_DECIMAL", val, valleft, valright);
    :}
    | LIT_CADENA:val
    {:
        RESULT = new Nodo("LIT_CADENA", val, valleft, valright);
    :}
    | LIT_VERDADERO:val
    {:
        RESULT = new Nodo("LIT_VERDADERO", "VERDADERO", valleft, valright);
    :}
    | LIT_FALSO:val
    {:
        RESULT = new Nodo("LIT_FALSO", "FALSO", valleft, valright);
    :}
;
