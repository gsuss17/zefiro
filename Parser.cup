import java_cup.runtime.*;

parser code {:
    public int erroresSintacticos = 0;
    public Nodo raizAST = null;

    @Override
    public void syntax_error(Symbol s) {
        erroresSintacticos++;
        String nombreToken = (s.sym >= 0 && s.sym < sym.terminalNames.length) 
                             ? sym.terminalNames[s.sym] 
                             : ("TOKEN_" + s.sym);
        String lexema = (s.value != null) ? s.value.toString() : nombreToken;

        // Lista de tokens válidos que CUP esperaba en esta posición
        java.util.List<Integer> idsEsperados = expected_token_ids();
        java.util.List<String> nombresEsperados = new java.util.ArrayList<>();

        for (int id : idsEsperados) {
            if (id != sym.error && id >= 0 && id < sym.terminalNames.length) {
                nombresEsperados.add(describirToken(id, sym.terminalNames[id]));
            }
        }

        String listaEsperados = nombresEsperados.isEmpty() 
                                ? "Ninguno" 
                                : String.join(", ", nombresEsperados);

        System.out.println(" -> Error sintáctico en Línea " + s.left + ", Columna " + s.right + 
                           ". No se esperaba: '" + lexema + "' (" + nombreToken + ")");
        System.out.println("    Tokens válidos esperados en esta posición: [ " + listaEsperados + " ]");
    }

    @Override
    public void unrecovered_syntax_error(Symbol s) throws java.lang.Exception {
        System.out.println(" -> Error sintáctico fatal en Línea " + s.left + ", Columna " + s.right + 
                           ". No se pudo recuperar el análisis.");
    }

    private String describirToken(int id, String nombre) {
        switch (nombre) {
            case "DEL_P_COMA": return "';'";
            case "DEL_COMA": return "','";
            case "DEL_PAR_IZQ": return "'('";
            case "DEL_PAR_DER": return "')'";
            case "OP_ASIGNA": return "'='";
            case "OP_SUMA": return "'+'";
            case "OP_RESTA": return "'-'";
            case "OP_MULT": return "'*'";
            case "OP_DIV": return "'/'";
            case "OP_IGUAL": return "'=='";
            case "OP_DIFERENTE": return "'!='";
            case "OP_MENOR": return "'<'";
            case "OP_MENOR_IGUAL": return "'<='";
            case "OP_MAYOR": return "'>'";
            case "OP_MAYOR_IGUAL": return "'>='";
            case "OP_Y": return "'Y'";
            case "OP_O": return "'O'";
            case "OP_NO": return "'NO'";
            case "ID": return "Identificador";
            case "LIT_ENTERO": return "Número Entero";
            case "LIT_DECIMAL": return "Número Decimal";
            case "LIT_CADENA": return "Texto";
            case "LIT_VERDADERO": return "'VERDADERO'";
            case "LIT_FALSO": return "'FALSO'";
            default: return nombre;
        }
    }
:};

/* Terminales */
terminal PR_INICIO, PR_FIN;
terminal PR_TIPO_ENT, PR_TIPO_DEC, PR_TIPO_CAD, PR_TIPO_BOOL;
terminal LIT_VERDADERO, LIT_FALSO;
terminal PR_SI, PR_SINO, PR_FINSI;
terminal PR_MIENTRAS, PR_FIN_MIE;
terminal PR_LEER, PR_IMPRIMIR;

terminal OP_SUMA, OP_RESTA, OP_MULT, OP_DIV;
terminal OP_ASIGNA;
terminal OP_IGUAL, OP_DIFERENTE, OP_MENOR, OP_MENOR_IGUAL, OP_MAYOR, OP_MAYOR_IGUAL;
terminal OP_Y, OP_O, OP_NO;

terminal DEL_P_COMA, DEL_COMA, DEL_PAR_IZQ, DEL_PAR_DER;

terminal String ID;
terminal String LIT_ENTERO;
terminal String LIT_DECIMAL;
terminal String LIT_CADENA;

terminal MENOS_UNARIO;

/* No Terminales tipados con Nodo */
non terminal Nodo programa;
non terminal Nodo lista_sentencias, sentencia;
non terminal Nodo tipo, declaracion, lista_vars, var_item;
non terminal Nodo asignacion, condicional, ciclo, lectura, escritura;
non terminal Nodo expresion;

/* Precedencia y Asociatividad */
precedence left OP_O;
precedence left OP_Y;
precedence right OP_NO;
precedence left OP_IGUAL, OP_DIFERENTE;
precedence left OP_MENOR, OP_MENOR_IGUAL, OP_MAYOR, OP_MAYOR_IGUAL;
precedence left OP_SUMA, OP_RESTA;
precedence left OP_MULT, OP_DIV;
precedence right MENOS_UNARIO;

/* Símbolo Inicial */
start with programa;

/* Reglas Gramaticales con Construcción de Hojas de Lexemas */
programa ::= 
    PR_INICIO ID:id DEL_P_COMA lista_sentencias:ls PR_FIN DEL_P_COMA
    {:
        Nodo n = new Nodo("PROGRAMA");
        n.agregarHijo(new Nodo("PR_INICIO", "INICIO"));
        n.agregarHijo(new Nodo("ID", id));
        n.agregarHijo(new Nodo("DEL_P_COMA", ";"));
        n.agregarHijo(ls);
        n.agregarHijo(new Nodo("PR_FIN", "FIN"));
        n.agregarHijo(new Nodo("DEL_P_COMA", ";"));
        parser.raizAST = n;
        RESULT = n;
    :}
;

lista_sentencias ::= 
    lista_sentencias:ls sentencia:s
    {:
        ls.agregarHijo(s);
        RESULT = ls;
    :}
    | sentencia:s
    {:
        Nodo n = new Nodo("LISTA_SENTENCIAS");
        n.agregarHijo(s);
        RESULT = n;
    :}
;

sentencia ::= 
    declaracion:d DEL_P_COMA
    {:
        Nodo n = new Nodo("SENTENCIA");
        n.agregarHijo(d);
        n.agregarHijo(new Nodo("DEL_P_COMA", ";"));
        RESULT = n;
    :}
    | asignacion:a DEL_P_COMA
    {:
        Nodo n = new Nodo("SENTENCIA");
        n.agregarHijo(a);
        n.agregarHijo(new Nodo("DEL_P_COMA", ";"));
        RESULT = n;
    :}
    | condicional:c
    {:
        Nodo n = new Nodo("SENTENCIA");
        n.agregarHijo(c);
        RESULT = n;
    :}
    | ciclo:m
    {:
        Nodo n = new Nodo("SENTENCIA");
        n.agregarHijo(m);
        RESULT = n;
    :}
    | lectura:l DEL_P_COMA
    {:
        Nodo n = new Nodo("SENTENCIA");
        n.agregarHijo(l);
        n.agregarHijo(new Nodo("DEL_P_COMA", ";"));
        RESULT = n;
    :}
    | escritura:e DEL_P_COMA
    {:
        Nodo n = new Nodo("SENTENCIA");
        n.agregarHijo(e);
        n.agregarHijo(new Nodo("DEL_P_COMA", ";"));
        RESULT = n;
    :}
    | error DEL_P_COMA
    {:
        Nodo n = new Nodo("SENTENCIA");
        n.agregarHijo(new Nodo("ERROR_SINTACTICO"));
        n.agregarHijo(new Nodo("DEL_P_COMA", ";"));
        RESULT = n;
    :}
;

tipo ::= 
    PR_TIPO_ENT
    {:
        Nodo n = new Nodo("TIPO");
        n.agregarHijo(new Nodo("PR_TIPO_ENT", "ENTERO"));
        RESULT = n;
    :}
    | PR_TIPO_DEC
    {:
        Nodo n = new Nodo("TIPO");
        n.agregarHijo(new Nodo("PR_TIPO_DEC", "DECIMAL"));
        RESULT = n;
    :}
    | PR_TIPO_CAD
    {:
        Nodo n = new Nodo("TIPO");
        n.agregarHijo(new Nodo("PR_TIPO_CAD", "CADENA"));
        RESULT = n;
    :}
    | PR_TIPO_BOOL
    {:
        Nodo n = new Nodo("TIPO");
        n.agregarHijo(new Nodo("PR_TIPO_BOOL", "BOOLEANO"));
        RESULT = n;
    :}
;

declaracion ::= 
    tipo:t lista_vars:lv
    {:
        Nodo n = new Nodo("DECLARACION");
        n.agregarHijo(t);
        n.agregarHijo(lv);
        RESULT = n;
    :}
    | tipo:t error
    {:
        Nodo n = new Nodo("DECLARACION");
        n.agregarHijo(t);
        n.agregarHijo(new Nodo("ERROR_DECLARACION"));
        RESULT = n;
    :}
;

lista_vars ::= 
    lista_vars:lv DEL_COMA var_item:vi
    {:
        lv.agregarHijo(new Nodo("DEL_COMA", ","));
        lv.agregarHijo(vi);
        RESULT = lv;
    :}
    | var_item:vi
    {:
        Nodo n = new Nodo("LISTA_VARS");
        n.agregarHijo(vi);
        RESULT = n;
    :}
;

var_item ::= 
    ID:id
    {:
        Nodo n = new Nodo("VAR_ITEM");
        n.agregarHijo(new Nodo("ID", id));
        RESULT = n;
    :}
    | ID:id OP_ASIGNA expresion:e
    {:
        Nodo n = new Nodo("VAR_ITEM");
        n.agregarHijo(new Nodo("ID", id));
        n.agregarHijo(new Nodo("OP_ASIGNA", "="));
        n.agregarHijo(e);
        RESULT = n;
    :}
;

asignacion ::= 
    ID:id OP_ASIGNA expresion:e
    {:
        Nodo n = new Nodo("ASIGNACION");
        n.agregarHijo(new Nodo("ID", id));
        n.agregarHijo(new Nodo("OP_ASIGNA", "="));
        n.agregarHijo(e);
        RESULT = n;
    :}
    | ID:id error
    {:
        Nodo n = new Nodo("ASIGNACION");
        n.agregarHijo(new Nodo("ID", id));
        n.agregarHijo(new Nodo("ERROR_ASIGNACION"));
        RESULT = n;
    :}
;

condicional ::= 
    PR_SI DEL_PAR_IZQ expresion:cond DEL_PAR_DER lista_sentencias:ls PR_FINSI DEL_P_COMA
    {:
        Nodo n = new Nodo("CONDICIONAL");
        n.agregarHijo(new Nodo("PR_SI", "SI"));
        n.agregarHijo(new Nodo("DEL_PAR_IZQ", "("));
        n.agregarHijo(cond);
        n.agregarHijo(new Nodo("DEL_PAR_DER", ")"));
        n.agregarHijo(ls);
        n.agregarHijo(new Nodo("PR_FINSI", "FINSI"));
        n.agregarHijo(new Nodo("DEL_P_COMA", ";"));
        RESULT = n;
    :}
    | PR_SI DEL_PAR_IZQ expresion:cond DEL_PAR_DER lista_sentencias:ls1 PR_SINO lista_sentencias:ls2 PR_FINSI DEL_P_COMA
    {:
        Nodo n = new Nodo("CONDICIONAL");
        n.agregarHijo(new Nodo("PR_SI", "SI"));
        n.agregarHijo(new Nodo("DEL_PAR_IZQ", "("));
        n.agregarHijo(cond);
        n.agregarHijo(new Nodo("DEL_PAR_DER", ")"));
        n.agregarHijo(ls1);
        n.agregarHijo(new Nodo("PR_SINO", "SINO"));
        n.agregarHijo(ls2);
        n.agregarHijo(new Nodo("PR_FINSI", "FINSI"));
        n.agregarHijo(new Nodo("DEL_P_COMA", ";"));
        RESULT = n;
    :}
    | PR_SI error PR_FINSI DEL_P_COMA
    {:
        Nodo n = new Nodo("CONDICIONAL");
        n.agregarHijo(new Nodo("PR_SI", "SI"));
        n.agregarHijo(new Nodo("ERROR_CONDICIONAL"));
        n.agregarHijo(new Nodo("PR_FINSI", "FINSI"));
        n.agregarHijo(new Nodo("DEL_P_COMA", ";"));
        RESULT = n;
    :}
;

ciclo ::= 
    PR_MIENTRAS DEL_PAR_IZQ expresion:cond DEL_PAR_DER lista_sentencias:ls PR_FIN_MIE DEL_P_COMA
    {:
        Nodo n = new Nodo("CICLO");
        n.agregarHijo(new Nodo("PR_MIENTRAS", "MIENTRAS"));
        n.agregarHijo(new Nodo("DEL_PAR_IZQ", "("));
        n.agregarHijo(cond);
        n.agregarHijo(new Nodo("DEL_PAR_DER", ")"));
        n.agregarHijo(ls);
        n.agregarHijo(new Nodo("PR_FIN_MIE", "FINMIENTRAS"));
        n.agregarHijo(new Nodo("DEL_P_COMA", ";"));
        RESULT = n;
    :}
    | PR_MIENTRAS error PR_FIN_MIE DEL_P_COMA
    {:
        Nodo n = new Nodo("CICLO");
        n.agregarHijo(new Nodo("PR_MIENTRAS", "MIENTRAS"));
        n.agregarHijo(new Nodo("ERROR_CICLO"));
        n.agregarHijo(new Nodo("PR_FIN_MIE", "FINMIENTRAS"));
        n.agregarHijo(new Nodo("DEL_P_COMA", ";"));
        RESULT = n;
    :}
;

lectura ::= 
    PR_LEER DEL_PAR_IZQ ID:id DEL_PAR_DER
    {:
        Nodo n = new Nodo("LECTURA");
        n.agregarHijo(new Nodo("PR_LEER", "LEER"));
        n.agregarHijo(new Nodo("DEL_PAR_IZQ", "("));
        n.agregarHijo(new Nodo("ID", id));
        n.agregarHijo(new Nodo("DEL_PAR_DER", ")"));
        RESULT = n;
    :}
    | PR_LEER error
    {:
        Nodo n = new Nodo("LECTURA");
        n.agregarHijo(new Nodo("PR_LEER", "LEER"));
        n.agregarHijo(new Nodo("ERROR_LECTURA"));
        RESULT = n;
    :}
;

escritura ::= 
    PR_IMPRIMIR DEL_PAR_IZQ expresion:e DEL_PAR_DER
    {:
        Nodo n = new Nodo("ESCRITURA");
        n.agregarHijo(new Nodo("PR_IMPRIMIR", "IMPRIMIR"));
        n.agregarHijo(new Nodo("DEL_PAR_IZQ", "("));
        n.agregarHijo(e);
        n.agregarHijo(new Nodo("DEL_PAR_DER", ")"));
        RESULT = n;
    :}
    | PR_IMPRIMIR error
    {:
        Nodo n = new Nodo("ESCRITURA");
        n.agregarHijo(new Nodo("PR_IMPRIMIR", "IMPRIMIR"));
        n.agregarHijo(new Nodo("ERROR_ESCRITURA"));
        RESULT = n;
    :}
;

expresion ::= 
    expresion:e1 OP_SUMA expresion:e2
    {:
        Nodo n = new Nodo("EXPRESION");
        n.agregarHijo(e1);
        n.agregarHijo(new Nodo("OP_SUMA", "+"));
        n.agregarHijo(e2);
        RESULT = n;
    :}
    | expresion:e1 OP_RESTA expresion:e2
    {:
        Nodo n = new Nodo("EXPRESION");
        n.agregarHijo(e1);
        n.agregarHijo(new Nodo("OP_RESTA", "-"));
        n.agregarHijo(e2);
        RESULT = n;
    :}
    | expresion:e1 OP_MULT expresion:e2
    {:
        Nodo n = new Nodo("EXPRESION");
        n.agregarHijo(e1);
        n.agregarHijo(new Nodo("OP_MULT", "*"));
        n.agregarHijo(e2);
        RESULT = n;
    :}
    | expresion:e1 OP_DIV expresion:e2
    {:
        Nodo n = new Nodo("EXPRESION");
        n.agregarHijo(e1);
        n.agregarHijo(new Nodo("OP_DIV", "/"));
        n.agregarHijo(e2);
        RESULT = n;
    :}
    | expresion:e1 OP_IGUAL expresion:e2
    {:
        Nodo n = new Nodo("EXPRESION");
        n.agregarHijo(e1);
        n.agregarHijo(new Nodo("OP_IGUAL", "=="));
        n.agregarHijo(e2);
        RESULT = n;
    :}
    | expresion:e1 OP_DIFERENTE expresion:e2
    {:
        Nodo n = new Nodo("EXPRESION");
        n.agregarHijo(e1);
        n.agregarHijo(new Nodo("OP_DIFERENTE", "!="));
        n.agregarHijo(e2);
        RESULT = n;
    :}
    | expresion:e1 OP_MENOR expresion:e2
    {:
        Nodo n = new Nodo("EXPRESION");
        n.agregarHijo(e1);
        n.agregarHijo(new Nodo("OP_MENOR", "<"));
        n.agregarHijo(e2);
        RESULT = n;
    :}
    | expresion:e1 OP_MENOR_IGUAL expresion:e2
    {:
        Nodo n = new Nodo("EXPRESION");
        n.agregarHijo(e1);
        n.agregarHijo(new Nodo("OP_MENOR_IGUAL", "<="));
        n.agregarHijo(e2);
        RESULT = n;
    :}
    | expresion:e1 OP_MAYOR expresion:e2
    {:
        Nodo n = new Nodo("EXPRESION");
        n.agregarHijo(e1);
        n.agregarHijo(new Nodo("OP_MAYOR", ">"));
        n.agregarHijo(e2);
        RESULT = n;
    :}
    | expresion:e1 OP_MAYOR_IGUAL expresion:e2
    {:
        Nodo n = new Nodo("EXPRESION");
        n.agregarHijo(e1);
        n.agregarHijo(new Nodo("OP_MAYOR_IGUAL", ">="));
        n.agregarHijo(e2);
        RESULT = n;
    :}
    | expresion:e1 OP_Y expresion:e2
    {:
        Nodo n = new Nodo("EXPRESION");
        n.agregarHijo(e1);
        n.agregarHijo(new Nodo("OP_Y", "Y"));
        n.agregarHijo(e2);
        RESULT = n;
    :}
    | expresion:e1 OP_O expresion:e2
    {:
        Nodo n = new Nodo("EXPRESION");
        n.agregarHijo(e1);
        n.agregarHijo(new Nodo("OP_O", "O"));
        n.agregarHijo(e2);
        RESULT = n;
    :}
    | OP_NO expresion:e
    {:
        Nodo n = new Nodo("EXPRESION");
        n.agregarHijo(new Nodo("OP_NO", "NO"));
        n.agregarHijo(e);
        RESULT = n;
    :}
    | OP_RESTA expresion:e
    {:
        Nodo n = new Nodo("EXPRESION");
        n.agregarHijo(new Nodo("OP_RESTA", "-"));
        n.agregarHijo(e);
        RESULT = n;
    :}
    %prec MENOS_UNARIO
    | DEL_PAR_IZQ expresion:e DEL_PAR_DER
    {:
        Nodo n = new Nodo("EXPRESION");
        n.agregarHijo(new Nodo("DEL_PAR_IZQ", "("));
        n.agregarHijo(e);
        n.agregarHijo(new Nodo("DEL_PAR_DER", ")"));
        RESULT = n;
    :}
    | ID:id
    {:
        RESULT = new Nodo("ID", id);
    :}
    | LIT_ENTERO:val
    {:
        RESULT = new Nodo("LIT_ENTERO", val);
    :}
    | LIT_DECIMAL:val
    {:
        RESULT = new Nodo("LIT_DECIMAL", val);
    :}
    | LIT_CADENA:val
    {:
        RESULT = new Nodo("LIT_CADENA", val);
    :}
    | LIT_VERDADERO
    {:
        RESULT = new Nodo("LIT_VERDADERO", "VERDADERO");
    :}
    | LIT_FALSO
    {:
        RESULT = new Nodo("LIT_FALSO", "FALSO");
    :}
;